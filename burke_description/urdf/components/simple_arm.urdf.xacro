<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Simulation assumptions: this is a compact primitive industrial-style arm,
    not a measured UR8L model. Segment dimensions, masses, limits, damping,
    and controller speeds are provisional and tunable.
  -->
  <xacro:property name="arm_mount_length" value="0.08"/>
  <xacro:property name="arm_mount_radius" value="0.10"/>
  <xacro:property name="arm_mount_mass" value="2.0"/>

  <!-- Named industrial-layout dimensions; all are simulation assumptions. -->
  <xacro:property name="arm_pedestal_length" value="0.28"/>
  <xacro:property name="arm_pedestal_radius" value="0.07"/>
  <xacro:property name="arm_upper_arm_length" value="0.34"/>
  <xacro:property name="arm_forearm_length" value="0.30"/>
  <xacro:property name="arm_wrist_length" value="0.07"/>
  <xacro:property name="arm_segment_radius" value="0.045"/>
  <xacro:property name="arm_pedestal_mass" value="2.4"/>
  <xacro:property name="arm_segment_mass" value="1.5"/>
  <xacro:property name="arm_wrist_mass" value="0.55"/>

  <!-- Conservative simulation limits: radians, radians/sec, and N-m. -->
  <xacro:property name="arm_joint_velocity_limit" value="1.2"/>
  <xacro:property name="arm_joint_effort_limit" value="30.0"/>
  <xacro:property name="arm_controller_speed_limit" value="1.2"/>
  <xacro:property name="arm_joint_damping" value="0.5"/>
  <xacro:property name="arm_joint_friction" value="0.1"/>

  <material name="arm_gray"><color rgba="0.55 0.58 0.62 1.0"/></material>
  <material name="arm_dark"><color rgba="0.25 0.28 0.32 1.0"/></material>

  <!-- The link frame follows the cylinder axis (local Z). Joint origins rotate
       the upper arm and wrist frames so their cylinders span their pivots. -->
  <xacro:macro name="arm_cylinder_link" params="name length radius mass material">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length / 2}"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length / 2}"/>
        <geometry><cylinder radius="${radius}" length="${length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${length / 2}"/>
        <mass value="${mass}"/>
        <!-- Solid-cylinder inertia, with its axis along the link Z frame. -->
        <inertia
          ixx="${mass * (3 * radius * radius + length * length) / 12}"
          ixy="0" ixz="0"
          iyy="${mass * (3 * radius * radius + length * length) / 12}"
          iyz="0"
          izz="${0.5 * mass * radius * radius}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="simple_arm" params="chassis_height">
    <!-- The fixed joint is on the top face of base_link. -->
    <link name="arm_mount_link">
      <visual>
        <origin xyz="0 0 ${arm_mount_length / 2}"/>
        <geometry><cylinder radius="${arm_mount_radius}" length="${arm_mount_length}"/></geometry>
        <material name="arm_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${arm_mount_length / 2}"/>
        <geometry><cylinder radius="${arm_mount_radius}" length="${arm_mount_length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${arm_mount_length / 2}"/>
        <mass value="${arm_mount_mass}"/>
        <inertia
          ixx="${arm_mount_mass * (3 * arm_mount_radius * arm_mount_radius + arm_mount_length * arm_mount_length) / 12}"
          ixy="0" ixz="0"
          iyy="${arm_mount_mass * (3 * arm_mount_radius * arm_mount_radius + arm_mount_length * arm_mount_length) / 12}"
          iyz="0"
          izz="${0.5 * arm_mount_mass * arm_mount_radius * arm_mount_radius}"/>
      </inertial>
    </link>
    <joint name="arm_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="arm_mount_link"/>
      <origin xyz="0 0 ${chassis_height / 2}"/>
    </joint>

    <!-- Zero pose: pedestal is vertical, then upper arm and forearm extend +X. -->
    <xacro:arm_cylinder_link name="arm_link_1" length="${arm_pedestal_length}" radius="${arm_pedestal_radius}" mass="${arm_pedestal_mass}" material="arm_dark"/>
    <xacro:arm_cylinder_link name="arm_link_2" length="${arm_upper_arm_length}" radius="${arm_segment_radius}" mass="${arm_segment_mass}" material="arm_gray"/>
    <xacro:arm_cylinder_link name="arm_link_3" length="${arm_forearm_length}" radius="${arm_segment_radius}" mass="${arm_segment_mass}" material="arm_dark"/>
    <xacro:arm_cylinder_link name="arm_link_4" length="${arm_wrist_length}" radius="${arm_segment_radius}" mass="${arm_wrist_mass}" material="arm_gray"/>
    <xacro:arm_cylinder_link name="arm_link_5" length="${arm_wrist_length}" radius="${arm_segment_radius}" mass="${arm_wrist_mass}" material="arm_dark"/>
    <xacro:arm_cylinder_link name="arm_link_6" length="${arm_wrist_length}" radius="${arm_segment_radius}" mass="${arm_wrist_mass}" material="arm_gray"/>

    <joint name="arm_joint_1" type="revolute">
      <parent link="arm_mount_link"/><child link="arm_link_1"/>
      <origin xyz="0 0 ${arm_mount_length}"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="${arm_joint_damping}" friction="${arm_joint_friction}"/>
      <limit lower="-3.14" upper="3.14" effort="${arm_joint_effort_limit}" velocity="${arm_joint_velocity_limit}"/>
    </joint>
    <joint name="arm_joint_2" type="revolute">
      <parent link="arm_link_1"/><child link="arm_link_2"/>
      <!-- Shoulder pivot at the top of the pedestal; child Z points +X. -->
      <origin xyz="0 0 ${arm_pedestal_length}" rpy="0 ${pi / 2} 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="${arm_joint_damping}" friction="${arm_joint_friction}"/>
      <limit lower="-1.57" upper="1.57" effort="${arm_joint_effort_limit}" velocity="${arm_joint_velocity_limit}"/>
    </joint>
    <joint name="arm_joint_3" type="revolute">
      <parent link="arm_link_2"/><child link="arm_link_3"/>
      <!-- Elbow pivot is one upper-arm length away from the shoulder. -->
      <origin xyz="0 0 ${arm_upper_arm_length}"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="${arm_joint_damping}" friction="${arm_joint_friction}"/>
      <limit lower="-2.35" upper="2.35" effort="${arm_joint_effort_limit}" velocity="${arm_joint_velocity_limit}"/>
    </joint>
    <joint name="arm_joint_4" type="revolute">
      <parent link="arm_link_3"/><child link="arm_link_4"/>
      <origin xyz="0 0 ${arm_forearm_length}"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="${arm_joint_damping}" friction="${arm_joint_friction}"/>
      <limit lower="-3.14" upper="3.14" effort="${arm_joint_effort_limit}" velocity="${arm_joint_velocity_limit}"/>
    </joint>
    <joint name="arm_joint_5" type="revolute">
      <parent link="arm_link_4"/><child link="arm_link_5"/>
      <origin xyz="0 0 ${arm_wrist_length}"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="${arm_joint_damping}" friction="${arm_joint_friction}"/>
      <limit lower="-1.57" upper="1.57" effort="${arm_joint_effort_limit}" velocity="${arm_joint_velocity_limit}"/>
    </joint>
    <joint name="arm_joint_6" type="revolute">
      <parent link="arm_link_5"/><child link="arm_link_6"/>
      <origin xyz="0 0 ${arm_wrist_length}"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="${arm_joint_damping}" friction="${arm_joint_friction}"/>
      <limit lower="-3.14" upper="3.14" effort="${arm_joint_effort_limit}" velocity="${arm_joint_velocity_limit}"/>
    </joint>

    <!-- Keep controller topics and initialized holding targets unchanged. -->
    <xacro:macro name="arm_position_controller" params="joint topic">
      <gazebo>
        <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
          <joint_name>${joint}</joint_name>
          <topic>${topic}</topic>
          <initial_position>0.0</initial_position>
          <use_velocity_commands>true</use_velocity_commands>
          <cmd_max>${arm_controller_speed_limit}</cmd_max>
          <cmd_min>-${arm_controller_speed_limit}</cmd_min>
        </plugin>
      </gazebo>
    </xacro:macro>
    <xacro:arm_position_controller joint="arm_joint_1" topic="/model/burke_base/arm/joint_1/command"/>
    <xacro:arm_position_controller joint="arm_joint_2" topic="/model/burke_base/arm/joint_2/command"/>
    <xacro:arm_position_controller joint="arm_joint_3" topic="/model/burke_base/arm/joint_3/command"/>
    <xacro:arm_position_controller joint="arm_joint_4" topic="/model/burke_base/arm/joint_4/command"/>
    <xacro:arm_position_controller joint="arm_joint_5" topic="/model/burke_base/arm/joint_5/command"/>
    <xacro:arm_position_controller joint="arm_joint_6" topic="/model/burke_base/arm/joint_6/command"/>

    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/model/burke_base/joint_states</topic>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
