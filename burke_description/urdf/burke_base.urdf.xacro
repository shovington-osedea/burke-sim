<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="burke_base">
  <!--
    Simulation assumptions: these provisional dimensions and masses describe
    a stable, primitive-geometry MiR1350-style base. Keep all tunable physical
    values here so Gazebo integration can consume the same values later.
  -->
  <!--
    CAD visual assumptions from the Task 1 audit:
    MiR1350_link.stl is a link-local derivative of the reduced 36,106-triangle
    source mesh. Its metre scale, approved +pi/2 yaw, and 0.000230 m bottom
    correction are baked into the vertices so every URDF viewer can use an
    identity visual transform.
  -->
  <xacro:property name="mir_visual_length" value="1.350"/>
  <xacro:property name="mir_visual_width" value="0.910"/>
  <xacro:property name="mir_visual_height" value="0.321230"/>

  <!-- The 5 mm per-side collision clearance is deliberately conservative. -->
  <xacro:property name="chassis_length" value="1.340"/>
  <xacro:property name="chassis_width" value="0.900"/>
  <xacro:property name="chassis_height" value="0.310963"/>
  <xacro:property name="chassis_collision_center_z" value="0.1555195"/>
  <!-- Place base_link and the CAD bottom at the drive-wheel axis height. -->
  <xacro:property name="chassis_center_z" value="0.120230"/>
  <xacro:property name="chassis_mass" value="450.0"/>
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width" value="0.06"/>
  <xacro:property name="wheel_separation" value="0.68"/>
  <xacro:property name="wheel_mass" value="3.0"/>
  <xacro:property name="caster_radius" value="0.075"/>
  <xacro:property name="caster_mass" value="1.0"/>
  <!-- Conservative contact assumptions for the simplified model. -->
  <xacro:property name="wheel_mu" value="0.9"/>
  <xacro:property name="wheel_mu2" value="0.9"/>

  <xacro:include filename="$(find burke_description)/urdf/components/ur8long.urdf.xacro"/>
  <xacro:include filename="$(find burke_description)/urdf/components/liftkit.urdf.xacro"/>
  <xacro:include filename="$(find burke_description)/urdf/components/mir_3d_lidar.urdf.xacro"/>

  <!-- Simulation assumptions for the bounded base controller. -->
  <xacro:property name="max_linear_velocity" value="0.5"/>
  <xacro:property name="max_angular_velocity" value="0.8"/>
  <xacro:property name="max_linear_acceleration" value="0.8"/>
  <xacro:property name="max_angular_acceleration" value="1.2"/>
  <xacro:property name="odom_publish_frequency" value="50.0"/>

  <material name="chassis_blue"><color rgba="0.08 0.22 0.42 1.0"/></material>
  <material name="mir_gray"><color rgba="0.48 0.50 0.53 1.0"/></material>
  <material name="arm_gray"><color rgba="0.72 0.74 0.77 1.0"/></material>
  <material name="liftkit_gray"><color rgba="0.38 0.42 0.47 1.0"/></material>
  <material name="wheel_black"><color rgba="0.03 0.03 0.03 1.0"/></material>
  <material name="caster_gray"><color rgba="0.35 0.35 0.35 1.0"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://burke_description/cad/stl/MiR1350_link.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="mir_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_collision_center_z}"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_collision_center_z}"/>
      <mass value="${chassis_mass}"/>
      <!-- Solid-box inertia for 45 kg and the collision dimensions above. -->
      <inertia ixx="3.400117" ixy="0" ixz="0" iyy="7.096117" iyz="0" izz="9.771000"/>
    </inertial>
  </link>

  <!-- Explicitly retain shadow casting for the CAD visual. -->
  <gazebo reference="base_link">
    <visual>
      <cast_shadows>true</cast_shadows>
    </visual>
  </gazebo>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${chassis_center_z}"/>
  </joint>

  <xacro:macro name="drive_wheel" params="side y">
    <link name="${side}_drive_wheel_link">
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.0108" ixy="0" ixz="0" iyy="0.0216" iyz="0" izz="0.0108"/>
      </inertial>
    </link>
    <joint name="${side}_drive_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_drive_wheel_link"/>
      <origin xyz="0 ${y} ${wheel_radius - chassis_center_z}"/>
      <axis xyz="0 1 0"/>
      <limit effort="100" velocity="30"/>
    </joint>
    <gazebo reference="${side}_drive_wheel_link">
      <mu1>${wheel_mu}</mu1>
      <mu2>${wheel_mu2}</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel side="left" y="${wheel_separation / 2}"/>
  <xacro:drive_wheel side="right" y="-${wheel_separation / 2}"/>

  <xacro:macro name="support_caster" params="name x">
    <link name="${name}_support_link">
      <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
      <inertial>
        <mass value="${caster_mass}"/>
        <inertia ixx="0.00225" ixy="0" ixz="0" iyy="0.00225" iyz="0" izz="0.00225"/>
      </inertial>
    </link>
    <joint name="${name}_support_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_support_link"/>
      <origin xyz="${x} 0 ${caster_radius - chassis_center_z}"/>
    </joint>
  </xacro:macro>

  <xacro:support_caster name="front" x="0.38"/>
  <xacro:support_caster name="rear" x="-0.38"/>

  <!-- Task 1-approved fixed front-deck mount; all values are assumptions. -->
  <xacro:mir_3d_lidar
    parent_link="base_link"
    mount_x="0.400" mount_y="0.000" mount_z="0.381230"
    mount_roll="0.000" mount_pitch="0.000" mount_yaw="0.000"
    housing_diameter="0.120" housing_height="0.100" housing_mass="2.000"
    horizontal_samples="640" horizontal_min_angle="-${pi}"
    horizontal_max_angle="${pi}"
    vertical_samples="16" vertical_min_angle="-${15 * pi / 180}"
    vertical_max_angle="${15 * pi / 180}"
    update_rate="10.0" min_range="0.20" max_range="50.0"
    range_resolution="0.010" noise_mean="0.0" noise_stddev="0.010"
    topic="/model/burke_base/lidar/points" visualize="false"/>

  <!-- Task 2: add the fixed lower stage and two bounded telescoping stages.
       The arm remains mounted directly to base_link until Task 3. -->
  <xacro:liftkit_mast parent_link="base_link" mount_z="${mir_visual_height}"/>

  <xacro:ur8long_arm
    arm_mount_parent="lift_stage_3_link"
    arm_mount_z="0.555"
    kinematics_parameters_file="$(find burke_description)/config/ur8long/default_kinematics.yaml"
    joint_limits_parameters_file="$(find burke_description)/config/ur8long/joint_limits.yaml"
    physical_parameters_file="$(find burke_description)/config/ur8long/physical_parameters.yaml"
    visual_parameters_file="$(find burke_description)/config/ur8long/visual_parameters.yaml"/>

  <!--
    Gazebo Harmonic's native differential-drive system. The short topic names
    are resolved in the spawned model namespace (/model/burke_base). The ROS
    bridge in burke_gazebo maps those internal topics to /cmd_vel, /odom, and
    /tf. All dimensions below are the properties above, so the plugin cannot
    silently diverge from the collision geometry.
  -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_drive_wheel_joint</left_joint>
      <right_joint>right_drive_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_velocity>${max_linear_velocity}</max_linear_velocity>
      <max_angular_velocity>${max_angular_velocity}</max_angular_velocity>
      <max_linear_acceleration>${max_linear_acceleration}</max_linear_acceleration>
      <max_angular_acceleration>${max_angular_acceleration}</max_angular_acceleration>
      <odom_publish_frequency>${odom_publish_frequency}</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>
</robot>
