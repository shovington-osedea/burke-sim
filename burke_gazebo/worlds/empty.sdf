<?xml version="1.0"?>
<sdf version="1.10">
  <world name="burke_empty">
    <!-- Simulation assumption: fixed Earth gravity and a deterministic 1 kHz
         physics update make the empty-world startup repeatable. -->
    <!--
      Keep the core world systems explicit because adding the Sensors system
      disables Gazebo's implicit default-system insertion. The lidar requires
      the Ogre renderer even when the GUI is disabled; the launch file selects
      the project-supported renderer and software-rendering policy.
    -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <physics name="burke_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Initial GUI view: frame both the robot at the origin and the aircraft
         centred around world Y=12 m. -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>18 -18 14 0 0.38 2.18</pose>
      </camera>
    </gui>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Challenger reduced aircraft assumptions:
      - challenger_reduced.stl is treated as millimetre-authored geometry and
        imported with a 0.001 scale factor.
      - Its measured raw bounds are x=[-9.681192, 9.681192] m,
        y=[0.968761, 6.668792] m, z=[3.657600, 24.332212] m after scaling.
      - challenger_collision.stl is the separate reduced collision mesh. Its
        scaled bounds are x=[-9.681139, 9.681139] m,
        y=[0.970236, 6.666029] m, z=[3.657600, 24.332213] m. It shares the
        visual mesh's source frame, scale, and pose.
      - The pose maps STL z to world +X (fuselage), STL x to world +Y
        (span), and STL y to world +Z (height). The translation centres the
        resulting 20.674612 m fuselage on world X=0, centres the aircraft on
        world Y=12 m, and puts its lowest point on the ground plane. This
        leaves the robot at the origin outside the aircraft collision bounds,
        beside the negative-Y wingtip. These are simulation import
        assumptions, not commissioned aircraft dimensions or a surveyed pose.
    -->
    <model name="challenger_reduced">
      <static>true</static>
      <pose>-13.994906 12 -0.5 1.57079632679 0 1.57079632679</pose>
      <link name="aircraft_link">
        <collision name="aircraft_collision">
          <geometry>
            <mesh>
              <uri>model://burke_description/cad/stl/challenger_collision.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name="aircraft_visual">
          <geometry>
            <mesh>
              <uri>model://burke_description/cad/stl/challenger_reduced.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.78 1</ambient>
            <diffuse>0.82 0.82 0.86 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>-6 -4 10 0.35 -0.45 0.25</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>
  </world>
</sdf>
